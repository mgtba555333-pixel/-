# Set paths to the model files you have permission to use.
MODEL_PATH=./model/best_chest_xray_model.h5
MODEL_CLASSES_PATH=./model/model_classes.txt

# Download the pinned MIT-listed Hugging Face model if the file is missing.
MODEL_AUTO_DOWNLOAD=true

# Must match the exact preprocessing used while training.
# Choices: raw, unit, resnet50, mobilenet_v2
XRAY_PREPROCESSING=auto
XRAY_COLOR_ORDER=rgb

# Maximum uploaded image size in megabytes.
MAX_UPLOAD_MB=12
